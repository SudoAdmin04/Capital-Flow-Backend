# Entorno
NODE_ENV=development
PORT=4002

# Base de datos
# Opción A: URL completa (Neon, Render, etc.). Tiene prioridad sobre DB_*.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
#
# Opción B: parámetros sueltos (docker compose up -d db)
DB_HOST=localhost
DB_PORT=5432
DB_USER=finanzas
DB_PASSWORD=finanzas
DB_NAME=finanzas
# Fuerza TLS on/off cuando la URL no incluye sslmode. Render interno: false.
# DB_SSL=false
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Auth (mínimo 32 caracteres; genera con: openssl rand -base64 48)
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
JWT_EXPIRES_IN=1d

# CORS: lista separada por comas de orígenes del frontend
CORS_ORIGINS=http://localhost:3000

# Seed local (pnpm run seed)
SEED_USER_EMAIL=alan@example.com
SEED_USER_PASSWORD=CambiaEstaClave123!
SEED_USER_NAME=Alan
SEED_DEMO_DATA=true

# Producción
# RUN_MIGRATIONS=true
# SEED_TOKEN=genera-un-token-largo-aleatorio
